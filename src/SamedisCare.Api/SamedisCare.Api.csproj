<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SamedisCare.Api</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>SamedisCare.Api</PackageId>
    <Title>Samedis.care API Client</Title>
    <Description>Shared access layer for the Samedis.care API V4: auth, HTTP, gridfilter, and resource routing for both normal and enterprise tenants. Foundation for the tools under samedis-care-tools.</Description>
    <PackageTags>samedis;samedis-care;api-client;medical-devices</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ship XML documentation so consumers get IntelliSense.
       CS1591 (missing XML comment) is suppressed for now — once the API layer is
       fully documented, this NoWarn can go. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Deliberately narrow dependency surface: only what the HTTP/JSON layer needs.
       YamlDotNet (config) and Microsoft.Data.Sqlite (sync state) stay out while the
       corresponding files are not migrated — otherwise every consumer would pull in
       dependencies it does not use. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="RestSharp" />
  </ItemGroup>

  <!-- Logging and date parsing are not API concerns, so they live in SamedisCare.Helper
       and this package builds on it. A tool that only needs logging can then depend on
       Helper alone instead of dragging in the HTTP client. -->
  <ItemGroup>
    <ProjectReference Include="../SamedisCare.Helper/SamedisCare.Helper.csproj" />
  </ItemGroup>

  <!-- The diagnostic CSV helpers are internal on purpose — they are an implementation
       detail, not part of the public surface — but they carry enough formatting logic
       (quoting, truncation) to be worth testing directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SamedisCare.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
