<Project>

  <!-- Gemeinsame Einstellungen für alle Projekte im Repo.
       Paket-spezifische Angaben (PackageId, Description) stehen in der jeweiligen .csproj. -->

  <!-- Multi-Targeting: net8.0 ist der kleinste gemeinsame Nenner (alle Tools laufen
       heute darauf), net9.0/net10.0 sind da, damit ein Tool einzeln migrieren kann,
       ohne dass die Lib angefasst werden muss. Ein niedrigeres TFM kann NIE ein
       höheres konsumieren — deshalb muss net8.0 im Paket bleiben, solange ein
       Consumer darauf steht.
       Hinweis: net8.0 und net9.0 erreichen am 10.11.2026 ihr End of Support,
       net10.0 ist LTS bis 11/2028. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Samedis.care</Authors>
    <Company>Samedis.care</Company>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.Year) Samedis.care</Copyright>
    <!-- Wird beim Release aus dem Git-Tag überschrieben: -p:Version=1.2.3 -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Standardmäßig wird nichts paketiert. Nur Projekte unter src/, die ein NuGet-Paket
       erzeugen sollen, setzen IsPackable=true. So kann ein Testprojekt nie versehentlich
       auf nuget.org landen. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Samedis-care/samedis-care-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Samedis-care/samedis-care-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- SourceLink + Symbole: erlaubt Consumern, in den Lib-Code hineinzudebuggen.
       SourceLink ist ab .NET 8 im SDK enthalten, es braucht kein extra Paket. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Reproduzierbare Builds nur in der CI aktivieren; lokal würde das Pfade
       normalisieren und die Debug-Erfahrung verschlechtern. -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
