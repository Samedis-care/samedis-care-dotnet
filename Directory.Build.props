<Project>

  <!-- Settings shared by every project in the repository.
       Package-specific values (PackageId, Description) live in the individual .csproj. -->

  <!-- Multi-targeting: net8.0 is the lowest common denominator (every tool runs on it
       today), net9.0/net10.0 exist so a tool can migrate on its own without the library
       having to change. A lower target framework can NEVER consume a higher one, which
       is why net8.0 must stay in the package for as long as a consumer is on it.
       Note: net8.0 and net9.0 reach end of support on 2026-11-10, net10.0 is LTS
       until 2028-11. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Samedis.care</Authors>
    <Company>Samedis.care</Company>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.Year) Samedis.care</Copyright>
    <!-- Overwritten from the git tag on release: -p:Version=1.2.3 -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Nothing is packable by default. Only projects under src/ that are meant to produce
       a NuGet package set IsPackable=true, so a test project can never end up on
       nuget.org by accident. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Samedis-care/samedis-care-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Samedis-care/samedis-care-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- SourceLink + symbols: lets consumers step into the library code while debugging.
       SourceLink ships with the SDK from .NET 8 on, so no extra package is needed. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Enable reproducible builds in CI only; locally it would normalize paths and make
       debugging worse. -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
